# Shared Railway PostgreSQL database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nocturne

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI provider and model. Railway can switch these without a code change.
# Supported providers: deepseek, openai, openrouter, openai_compatible
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash
# Optional separate task classes; each falls back to AI_MODEL.
AI_AUTHORITATIVE_MODEL=deepseek-v4-flash
AI_CREATIVE_MODEL=deepseek-v4-flash
# Provider default is used when blank. Required for openai_compatible.
AI_BASE_URL=https://api.deepseek.com
# Generic key overrides provider-specific keys when set.
AI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Structured world actions should normally disable DeepSeek thinking mode.
AI_THINKING_MODE=disabled
AI_JSON_MODE=true
AI_SEND_TEMPERATURE=true
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=60000
# Optional JSON object merged into provider requests for compatibility settings.
AI_EXTRA_BODY_JSON={}
# Optional OpenRouter attribution headers.
AI_HTTP_REFERER=
AI_APP_TITLE=Nocturne

NOCTURNE_ALLOW_DETERMINISTIC_AI_FALLBACK=false
# Server-only secret used to derive reproducible action seeds. Use a separate random value in production.
NOCTURNE_RESOLUTION_SECRET=replace-with-random-resolution-secret
NOCTURNE_ROLL_SECRET=replace-with-random-roll-secret

# Durable AI jobs. Set the same secret on API and worker services.
AI_JOB_WORKER_SECRET=replace-with-a-random-worker-secret
AI_JOB_API_URL=http://localhost:3001

# Services
PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info
