# Shared Railway PostgreSQL database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nocturne

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI architecture: Jev interprets semantics; deterministic code owns reality; Laguna XS renders committed facts.
AI_PROVIDER=openrouter
AI_GENERATIVE_MODEL=qwen/qwen3.7-flash
# Compatibility alias for older generation call sites. Prefer AI_GENERATIVE_MODEL.
AI_MODEL=qwen/qwen3.7-flash
# Transitional rich-structure task overrides. They fall back to AI_GENERATIVE_MODEL.
AI_AUTHORITATIVE_MODEL=qwen/qwen3.7-flash
AI_CREATIVE_MODEL=qwen/qwen3.7-flash
# Presentation-only narrator. No structured output; no player-command interpretation.
AI_NARRATION_MODEL=poolside/laguna-xs-2.1
AI_BASE_URL=https://openrouter.ai/api/v1

# Jev uses OpenRouter's Decisions API rather than chat completions.
AI_DECISION_MODEL=typesafe/jev-1.13-20260917
AI_DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
AI_DECISION_TIMEOUT_MS=5000
# Optional separate key. When blank, Jev reuses OPENROUTER_API_KEY / AI_API_KEY.
AI_DECISION_API_KEY=

# Generic key overrides the generation provider-specific key when set.
AI_API_KEY=
OPENROUTER_API_KEY=
# Legacy provider-specific keys remain supported for rollback/testing.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Transitional structured-generation settings for non-player legacy tasks.
AI_THINKING_MODE=omit
AI_JSON_MODE=true
AI_SEND_TEMPERATURE=true
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=60000
AI_EXTRA_BODY_JSON={}
AI_HTTP_REFERER=
AI_APP_TITLE=Nocturne

NOCTURNE_ALLOW_DETERMINISTIC_AI_FALLBACK=false
NOCTURNE_RESOLUTION_SECRET=replace-with-random-resolution-secret
NOCTURNE_ROLL_SECRET=replace-with-random-roll-secret

# Durable AI jobs. Set the same secret on API and worker services.
AI_JOB_WORKER_SECRET=replace-with-a-random-worker-secret
AI_JOB_API_URL=http://localhost:3001

# Production authentication. Guest mode should only be enabled for local or isolated CI use.
NOCTURNE_GUEST_MODE=false
NEXT_PUBLIC_NOCTURNE_GUEST_MODE=false

# Remote MCP account linking. MCP, web, and API must share MCP_ACCOUNT_LINK_SECRET.
MCP_PUBLIC_BASE_URL=http://localhost:3002
MCP_OAUTH_SIGNING_SECRET=replace-with-a-separate-32-character-secret
MCP_ACCOUNT_LINK_SECRET=replace-with-a-separate-32-character-secret
MCP_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,localhost,127.0.0.1
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_REQUEST_TIMEOUT_MS=120000
NOCTURNE_MCP_URL=http://localhost:3002
NOCTURNE_WEB_URL=http://localhost:3000
NOCTURNE_API_URL=http://localhost:3001
NOCTURNE_API_AUTH_MODE=bearer

# Services
PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info
