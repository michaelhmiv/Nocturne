# Shared Railway PostgreSQL database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nocturne

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenRouter. Add this in Railway when deploying.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NOCTURNE_AUTHORITATIVE_MODEL=openrouter/free
NOCTURNE_CREATIVE_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Nocturne
# Development/test only. Never enable as a production substitute for authoritative AI.
NOCTURNE_ALLOW_DETERMINISTIC_AI_FALLBACK=false

# Services
PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info
