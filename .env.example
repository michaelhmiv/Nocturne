# Shared Railway PostgreSQL database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nocturne

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI provider: direct DeepSeek API using the code-pinned deepseek-v4-flash model
DEEPSEEK_API_KEY=
NOCTURNE_ALLOW_DETERMINISTIC_AI_FALLBACK=false
# Server-only secret used to derive reproducible action seeds. Use a separate random value in production.
NOCTURNE_RESOLUTION_SECRET=replace-with-random-resolution-secret

# Durable AI jobs. Set the same secret on API and worker services.
AI_JOB_WORKER_SECRET=replace-with-a-random-worker-secret
AI_JOB_API_URL=http://localhost:3001

# Services
PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info
