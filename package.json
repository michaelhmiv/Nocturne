{
  "name": "nocturne",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=1",
    "test:certification": "vitest run test/capabilities test/telemetry test/action-matrix",
    "test:action-matrix": "vitest run test/action-matrix/action-matrix.test.ts",
    "test:capabilities": "vitest run test/capabilities",
    "test:telemetry": "vitest run test/telemetry apps/api/src/world-action-handler-registry.test.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:certification && pnpm build",
    "ci:static": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:certification && pnpm build",
    "db:migrate": "pnpm --filter @nocturne/database db:migrate",
    "db:check": "pnpm --filter @nocturne/database db:check",
    "auth:generate": "pnpm --filter @nocturne/auth auth:generate",
    "auth:migrate": "pnpm --filter @nocturne/auth auth:migrate",
    "nocturne:cli": "tsx scripts/nocturne-cli.ts",
    "nocturne:agent": "tsx scripts/nocturne-agent.ts",
    "nocturne:scenario": "tsx scripts/nocturne-scenario.ts",
    "test:cli": "vitest run test/cli.test.ts"
  },
  "devDependencies": {
    "@nocturne/agent-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
